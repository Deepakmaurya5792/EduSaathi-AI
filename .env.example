# ==========================================
# EduSaathi AI — Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Security & Authentication
JWT_SECRET=edusaathi_super_secret_jwt_key_change_in_production_min32chars
JWT_EXPIRES_IN=7d

# Database Configuration (MongoDB)
# If left blank or MongoDB is not running locally, server automatically starts an in-memory MongoDB instance for development!
MONGODB_URI=mongodb://localhost:27017/edusaathi

# AI Provider Configuration
# Supported providers: "demo" (built-in offline deterministic tutor & quiz engine, no API key needed), "gemini", "openai"
AI_PROVIDER=demo

# Google Gemini API Key (Required if AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Required if AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Adaptive Learning Thresholds (Configurable)
MASTERY_THRESHOLD_FOUNDATION=40
MASTERY_THRESHOLD_MASTERY=75

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
